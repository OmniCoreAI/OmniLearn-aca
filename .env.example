# Unified env — copy to .env:
#   cp .env.example .env
#   docker compose up --build
#
# Starts Postgres + Redis + app (frontend + API + collab) at http://localhost:8080

HTTP_PORT=8080
COLLAB_PORT=4040

POSTGRES_USER=omnilearn
POSTGRES_PASSWORD=omnilearn
POSTGRES_DB=omnilearn

# Local compose DB (service name `db`). Outside Docker this is rewritten to 127.0.0.1:5433.
OMNILEARN_SQL_CONNECTION_STRING=postgresql://omnilearn:omnilearn@db:5432/omnilearn
# Managed Postgres alternative:
# OMNILEARN_SQL_CONNECTION_STRING=postgresql://USER:PASSWORD@HOST:25060/DATABASE?sslmode=require

OMNILEARN_DOMAIN=localhost:8080
OMNILEARN_AUTH_JWT_SECRET_KEY=generate-with-python-secrets-token_urlsafe-32
NEXTAUTH_SECRET=generate-with-python-secrets-token_urlsafe-32
COLLAB_INTERNAL_KEY=generate-with-python-secrets-token_urlsafe-32

OMNILEARN_INITIAL_ORG_NAME=aca
OMNILEARN_INITIAL_ORG_SLUG=aca
OMNILEARN_INITIAL_ADMIN_EMAIL=admin@omnicoreai.com
OMNILEARN_INITIAL_ADMIN_PASSWORD=change-me

# Email through Brevo's SMTP relay (Brevo → SMTP & API → SMTP). Port 2525
# because DigitalOcean blocks the usual SMTP ports on droplets. The sender
# address must be verified in Brevo.
# OMNILEARN_EMAIL_PROVIDER=smtp
# OMNILEARN_SMTP_HOST=smtp-relay.brevo.com
# OMNILEARN_SMTP_PORT=2525
# OMNILEARN_SMTP_USE_TLS=true
# OMNILEARN_SMTP_USERNAME=<Brevo SMTP login, e.g. xxxx@smtp-brevo.com>
# OMNILEARN_SMTP_PASSWORD=<Brevo SMTP key>
# OMNILEARN_SYSTEM_EMAIL_ADDRESS=no-reply@example.com
# OMNILEARN_SYSTEM_EMAIL_NAME=Your Academy

# Login, sign-up and password reset live on the main website: the LMS's own
# /login, /signup, /forgot and /reset redirect there, and reset emails link to
# the reset page. Leave unset to keep the LMS's own pages.
# OMNILEARN_LOGIN_URL=https://aca.example.com/login
# OMNILEARN_SIGNUP_URL=https://aca.example.com/register
# OMNILEARN_PASSWORD_RESET_URL=https://aca.example.com/forgot-password
# Share the session with the main website (single tenancy; a dotted parent).
# OMNILEARN_COOKIE_DOMAIN=.example.com
